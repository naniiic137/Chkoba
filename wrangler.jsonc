// Cloudflare Worker config: the Worker serves public/ and runs every game room in a
// Durable Object. See the README section "Deploy to Cloudflare".
{
  "name": "chkobba",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // pages that may use this server from another site (the Pages copy of public/);
  // comma-separated, subdomains included
  "vars": { "ALLOWED_HOSTS": "chkooba.pages.dev,chkooba.netlify.app" }
}
